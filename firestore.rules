rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActive() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true;
    }

    function validProfile(d) {
      return d.displayName is string && d.displayName.size() <= 40
        && d.phone is string && d.phone.size() <= 20
        && d.dob is string && d.dob.size() <= 10
        && d.photoData is string && d.photoData.size() <= 150000;
    }

    // --- users collection ---
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();

      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.disabled == false
        && validProfile(request.resource.data);

      allow update: if (request.auth.uid == uid
          && validProfile(request.resource.data)
          && request.resource.data.role == resource.data.role
          && request.resource.data.disabled == resource.data.disabled)
        || isAdmin();

      allow delete: if false;
    }

    // --- auctions collection ---
    match /auctions/{auctionId} {
      allow read: if true;

      allow create: if isActive()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.currentBid == request.resource.data.startPrice
        && request.resource.data.bidCount == 0
        && request.resource.data.bidderIds == []
        && request.resource.data.startPrice > 0
        && request.resource.data.minIncrement > 0
        && request.resource.data.endsAt > request.time;

      allow update: if isAdmin() || (
        isActive()
        && request.auth.uid != resource.data.sellerId
        && request.time < resource.data.endsAt
        && request.resource.data.highestBidderId == request.auth.uid
        && request.resource.data.bidCount == resource.data.bidCount + 1
        && request.resource.data.bidCount > 0
        && request.auth.uid in request.resource.data.bidderIds
        && request.resource.data.currentBid >= (
            resource.data.bidCount == 0
              ? resource.data.startPrice
              : resource.data.currentBid + resource.data.minIncrement
          )
      );

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.sellerId && resource.data.bidCount == 0);

      // --- bids subcollection ---
      match /bids/{bidId} {
        allow read: if true;
        allow create: if isActive() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
  }
}
