rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- users collection ---
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // --- players collection (public directory of sports players) ---
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // --- teams / bidders collection (public directory of team owners) ---
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // --- sports auctions collection ---
    match /auctions/{auctionId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();

      // bids subcollection
      match /bids/{bidId} {
        allow read: if true;
        allow create: if signedIn();
        allow delete: if isAdmin();
      }
    }
  }
}
